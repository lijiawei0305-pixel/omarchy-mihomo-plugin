import QtQuick

// UI strings. Default language is English. `t()` is the only API pages need.
QtObject {
  id: root

  property string language: "en"

  function t(key) {
    var table = language === "zh" ? zh : en
    var value = table[key]
    if (value === undefined || value === null) value = en[key]
    if (value === undefined || value === null) value = key
    var text = String(value)
    for (var i = 1; i < arguments.length; i++) {
      var arg = arguments[i]
      if (arg !== undefined && arg !== null)
        text = text.replace("%" + i, String(arg))
    }
    return text
  }

